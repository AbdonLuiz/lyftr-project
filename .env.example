# Copy to .env and replace the placeholders. Never commit real keys.

# Comma-separated provider keys. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=replace-with-key-1,replace-with-key-2

# LiteLLM model used for every key, unless LLM_MODELS is set.
LLM_MODEL=gemini/gemini-2.0-flash

# Optional. One LiteLLM model per key, same order as LLM_API_KEYS.
# Example: gemini/gemini-2.0-flash,groq/llama-3.3-70b-versatile
LLM_MODELS=

# Local process path. Docker Compose overrides this to sqlite:////data/app.db.
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated browser origins. Add the deployed frontend URL before going live.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required on the deployed backend so X-Simulate-Failure can demonstrate failover.
ENABLE_FAILURE_SIMULATION=true

DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
LLM_TIMEOUT_SECONDS=45
CACHE_TTL_SECONDS=86400

# Frontend container only. The browser calls this URL.
API_BASE_URL=http://localhost:8000
